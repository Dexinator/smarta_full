---
// Layout reutilizable para páginas de oficina virtual
import Layout from '../components/Layout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import MapSection from '../components/adventure/MapSection.astro';
import VimeoHeroPlayer from '../components/react/VimeoHeroPlayer.jsx';
import MobileVideoControls from '../components/react/MobileVideoControls.jsx';
import { getTranslations } from '../i18n/utils';

// Importar componente Image y getImage de Astro para optimización automática
import { Image, getImage } from 'astro:assets';

// Importar imágenes de burbujas optimizadas
import imgMacJoseFuentes from '../assets/images/main_page/arte.png';
import imgMuseoGrabado from '../assets/images/burbujas/Museo del Grabado.png';
import imgEspacioSerzo from '../assets/images/burbujas/Espacio Serzo.png';
import imgEspacioAgustin from '../assets/images/burbujas/Espacio Agustín Casillas.png';
import imgSalaTragaluz from '../assets/images/burbujas/Sala Tragaluz.png';
import imgSalaMiguelDelibes from '../assets/images/burbujas/Sala Miguel Delibes.png';
import imgSalaProtagonistas from '../assets/images/burbujas/Sala Protagonistas.png';
import imgRutaMurales from '../assets/images/burbujas/Ruta Murales.png';
import imgArteEmboscado from '../assets/images/burbujas/Arte Emboscado.png';
import imgAudioguiaMurales from '../assets/images/burbujas/Auidoguía Murales.png';
import imgIslaSoto from '../assets/images/burbujas/Isla del Soto.png';
import imgCentroInterpretacion from '../assets/images/burbujas/Centro de Interpretación.png';
import imgAudioguiaIsla from '../assets/images/burbujas/Audioguía Isla del Soto.png';
import imgMuseoMoto from '../assets/images/burbujas/Museo de la Moto Histórica.png';
import imgRutaLapices from '../assets/images/burbujas/ruta lápices.png';
import imgRutaBichos from '../assets/images/burbujas/Ruta Bichos.png';
import imgIslaEncantada from '../assets/images/burbujas/Espacio Isla del Soto Encantada.png';
import imgAventuras from '../assets/images/burbujas/Aventuras.png';

interface Props {
  config: any; // Configuración desde content collection
}

const { config } = Astro.props;
const {
  title,
  description,
  lang = 'es',
  hero,
  lecturaFacil,
  mapa,
  bannerCTA,
  infoHorarios,
  actividades,
  burbujas: burbujasFiltradas,
} = config;

// Obtener traducciones
const t = await getTranslations(lang);

// Obtener el tema del banner (por defecto blue)
const bannerTheme = bannerCTA?.bgGradientTheme || 'blue';

// Definir todas las burbujas disponibles con imágenes y títulos bilingües
const todasBurbujas = {
  'MAC José Fuentes': {
    titleEs: 'MAC José Fuentes',
    titleEn: 'MAC José Fuentes',
    link: 'https://www.turismosantamartadetormes.com/museo/museo-de-arte-contemporaneo',
    img: imgMacJoseFuentes
  },
  'Museo del Grabado': {
    titleEs: 'Museo del Grabado',
    titleEn: 'Museum of Printmaking',
    link: 'https://www.turismosantamartadetormes.com/museo/museo-de-grabado',
    img: imgMuseoGrabado
  },
  'Espacio Serzo': {
    titleEs: 'Espacio Serzo',
    titleEn: 'Serzo Space',
    link: 'https://www.turismosantamartadetormes.com/museo/espacio-serzo',
    img: imgEspacioSerzo
  },
  'Espacio Agustín Casillas': {
    titleEs: 'Espacio Agustín Casillas',
    titleEn: 'Agustín Casillas Space',
    link: 'https://www.turismosantamartadetormes.com/museo/espacio-agustin-casillas-escultura',
    img: imgEspacioAgustin
  },
  'Sala Tragaluz': {
    titleEs: 'Sala Tragaluz',
    titleEn: 'Tragaluz Gallery',
    link: 'https://www.turismosantamartadetormes.com/museo/sala-tragaluz',
    img: imgSalaTragaluz
  },
  'Sala Miguel Delibes': {
    titleEs: 'Sala Miguel Delibes',
    titleEn: 'Miguel Delibes Gallery',
    link: 'https://www.turismosantamartadetormes.com/museo/sala-miguel-delibes',
    img: imgSalaMiguelDelibes
  },
  'Sala Protagonistas': {
    titleEs: 'Sala Protagonistas',
    titleEn: 'Protagonistas Gallery',
    link: 'https://www.turismosantamartadetormes.com/museo/sala-protagonistas',
    img: imgSalaProtagonistas
  },
  'Ruta Murales': {
    titleEs: 'Ruta Murales',
    titleEn: 'Murals Route',
    link: 'https://www.turismosantamartadetormes.com/ruta-murales',
    img: imgRutaMurales
  },
  'Arte Emboscado': {
    titleEs: 'Arte Emboscado',
    titleEn: 'Emboscado Art',
    link: 'https://www.turismosantamartadetormes.com/arte-emboscado',
    img: imgArteEmboscado
  },
  'Audioguía Murales': {
    titleEs: 'Audioguía Murales',
    titleEn: 'Murals Audio Guide',
    link: 'https://murales.santamartaccesible.com',
    img: imgAudioguiaMurales
  },
  'Isla del Soto': {
    titleEs: 'Isla del Soto',
    titleEn: 'Soto Island',
    link: 'https://www.turismosantamartadetormes.com/isla-del-soto',
    img: imgIslaSoto
  },
  'Centro de Interpretación': {
    titleEs: 'Centro de Interpretación',
    titleEn: 'Interpretation Center',
    link: 'https://www.turismosantamartadetormes.com/museo/centro-de-interpretacion-isla-del-soto',
    img: imgCentroInterpretacion
  },
  'Audioguía Isla del Soto': {
    titleEs: 'Audioguía Isla del Soto',
    titleEn: 'Soto Island Audio Guide',
    link: 'https://soto.santamartaccesible.com/',
    img: imgAudioguiaIsla
  },
  'Museo de la Moto Histórica': {
    titleEs: 'Museo de la Moto Histórica',
    titleEn: 'Historical Motorcycle Museum',
    link: 'https://www.turismosantamartadetormes.com/museo/museo-de-la-moto-historica',
    img: imgMuseoMoto
  },
  'Ruta Lápices': {
    titleEs: 'Ruta Lápices',
    titleEn: 'Pencils Route',
    link: 'https://www.turismosantamartadetormes.com/ruta-lapices',
    img: imgRutaLapices
  },
  'Ruta Bichos': {
    titleEs: 'Ruta Bichos',
    titleEn: 'Bugs Route',
    link: 'https://www.turismosantamartadetormes.com/ruta-bichos-soto',
    img: imgRutaBichos
  },
  'Isla del Soto Encantada': {
    titleEs: 'Isla del Soto Encantada',
    titleEn: 'Enchanted Soto Island',
    link: 'https://www.turismosantamartadetormes.com/museo/espacio-isla-encantada',
    img: imgIslaEncantada
  },
  'Aventuras': {
    titleEs: 'Aventuras',
    titleEn: 'Adventures',
    link: '/#adventures',
    img: imgAventuras
  },
};

// Filtrar burbujas según configuración (o usar todas si no hay filtro)
const burbujas = burbujasFiltradas
  ? burbujasFiltradas.map((nombre: string) => todasBurbujas[nombre]).filter(Boolean)
  : Object.values(todasBurbujas);

// Calcular URL para el cambio de idioma
// Extraer el pathname actual y construir la URL correspondiente
const currentPath = Astro.url.pathname;
let languageSwitchUrl: string;

if (lang === 'es') {
  // Estamos en español, agregar prefijo /en
  languageSwitchUrl = `/en${currentPath}`;
} else {
  // Estamos en inglés, remover prefijo /en
  languageSwitchUrl = currentPath.replace(/^\/en/, '');
}
---

<Layout
  title={title}
  description={description}
  lang={lang}
>
  <Header currentPage="ofi_virtual" lang={lang} languageSwitchUrl={languageSwitchUrl} />

  <main id="main-content" class="flex-1">
    <!-- Sección 1: Video Hero -->
    {hero?.visible && (
      <section id="video-section" class="relative h-[100dvh] w-full overflow-hidden -mt-[60px] md:-mt-0">
        <div id="hero-overlay" class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/40 z-10"></div>

        <!-- Contenedor del video Vimeo -->
        <div class="absolute inset-0 flex items-center justify-center bg-black">
          <VimeoHeroPlayer
            vimeoId={hero.videoUrl}
            language={lang}
            client:load
            className="w-full h-full"
          />
        </div>

        <!-- Overlay con título -->
        <div class="absolute inset-0 z-40 flex flex-col items-center justify-center text-white text-center px-4">
          <h1 id="hero-title" class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold mb-4 animate-fade-in-up">
            {hero.title}
          </h1>
        </div>

        <!-- Controles móviles del video (justo abajo del video, solo móvil) -->
        <div class="absolute bottom-0 left-0 right-0 z-50 md:hidden">
          <div class="flex justify-center pb-4">
            <MobileVideoControls
              language={lang}
              client:load
            />
          </div>
        </div>
      </section>
    )}

    <!-- Sección 2: Lectura Fácil -->
    {lecturaFacil?.visible && (
      <section id="lectura-facil" class="bg-white dark:bg-slate-900 py-12 sm:py-16 md:py-20">
        <div class="w-full px-4 sm:container sm:mx-auto sm:max-w-4xl">
          <div class="text-center mb-8">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4 sm:mb-6">
              {t.virtualOffice.lecturaFacil.title}
            </h2>
            {lecturaFacil.subtitle && (
              <p class="text-lg sm:text-xl md:text-2xl text-slate-600 dark:text-slate-300 mb-6 sm:mb-8">
                {lecturaFacil.subtitle}
              </p>
            )}

            <!-- Dos botones cuadrados grandes -->
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center mt-6 sm:mt-8">
              <button
                onclick="document.getElementById('transcripcion-lectura-facil').scrollIntoView({ behavior: 'smooth', block: 'start' })"
                class="w-full sm:w-64 md:w-72 h-32 sm:h-36 md:h-40 bg-SM-blue hover:bg-blue-700 active:bg-blue-800 text-white rounded-2xl font-bold text-xl sm:text-2xl transition-all transform active:scale-95 shadow-xl hover:shadow-2xl flex flex-col items-center justify-center gap-2"
                aria-label={t.virtualOffice.lecturaFacil.ariaReadInfo}
              >
                <span class="text-4xl sm:text-5xl" aria-hidden="true">📖</span>
                <span>{t.virtualOffice.lecturaFacil.readInfo}</span>
              </button>

              {lecturaFacil.pdfUrl && (
                <a
                  href={lecturaFacil.pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full sm:w-64 md:w-72 h-32 sm:h-36 md:h-40 bg-SM-yellow hover:bg-yellow-500 active:bg-yellow-600 text-slate-900 rounded-2xl font-bold text-xl sm:text-2xl transition-all transform active:scale-95 shadow-xl hover:shadow-2xl flex flex-col items-center justify-center gap-2"
                  aria-label={t.virtualOffice.lecturaFacil.ariaDownloadPdf}
                >
                  <span class="text-4xl sm:text-5xl" aria-hidden="true">📄</span>
                  <span>{t.virtualOffice.lecturaFacil.downloadPdf}</span>
                </a>
              )}
            </div>
          </div>

        </div>
      </section>
    )}


    <!-- Sección 3: Mapa -->
    {mapa?.visible && (
      <section id="mapa" class="py-12 px-4 sm:px-6 lg:px-8 bg-slate-50 dark:bg-slate-800">
        <div class="max-w-7xl mx-auto">
          <MapSection
            locations={mapa.locations}
            center={mapa.center}
            zoom={mapa.zoom}
            lang={lang}
          />
        </div>
      </section>
    )}

    <!-- Sección 4: Banner CTA -->
    {bannerCTA?.visible && (
      <section
        id="banner-cta"
        data-theme={bannerTheme}
        class="banner-cta min-h-[50vh] sm:min-h-[40vh] flex items-center"
      >
        <a
          href={bannerCTA.link}
          class="w-full py-8 sm:py-12 px-4 hover:opacity-90 transition-opacity active:scale-[0.99] transform"
        >
          <div class="container mx-auto max-w-6xl">
            <div class="flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-6 sm:gap-4 text-center sm:text-left">
              <!-- Icono y texto -->
              <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 flex-1">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                  <span class="text-5xl sm:text-6xl">{bannerCTA.emoji}</span>
                </div>
                <div class="text-white">
                  <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-2 sm:mb-3">
                    {bannerCTA.title}
                  </h2>
                  <p class="text-base sm:text-lg md:text-xl opacity-90">
                    {bannerCTA.subtitle}
                  </p>
                </div>
              </div>

              <!-- Flecha (solo visible en desktop) -->
              <div class="hidden sm:flex flex-shrink-0" aria-hidden="true">
                <svg class="w-10 h-10 md:w-12 md:h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>

              <!-- Texto "Toca para explorar" en móvil -->
              <div class="sm:hidden text-white/80 text-sm flex items-center gap-2">
                <span>{t.virtualOffice.banner.tapToExplore}</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- Sección 5: Más información y horarios -->
    {burbujas && burbujas.length > 0 && (
    <section id="mas-info-horarios" class="bg-slate-50 dark:bg-slate-800 pt-24 pb-12 sm:pt-28 sm:pb-16 md:pt-32 md:pb-20">
      <div class="container mx-auto px-4 max-w-6xl">
        <!-- Título -->
        <div class="text-center mb-8 sm:mb-12">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-2 sm:mb-3">
            {t.virtualOffice.moreInfo.title}
          </h2>
          <p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 mt-3">
            {t.virtualOffice.moreInfo.subtitle}
          </p>
        </div>

        <!-- Grid de burbujas con imágenes optimizadas -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-6">
          {burbujas.map((burbuja, index) => {
            // Las primeras 6 imágenes se cargan con prioridad alta, el resto con lazy loading
            const isEager = index < 6;

            return (
              <a
                href={burbuja.link}
                class="flex flex-col items-center group"
              >
                <div class="w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 rounded-full shadow-lg group-hover:shadow-xl group-active:scale-95 transform transition-all overflow-hidden mb-3">
                  <Image
                    src={burbuja.img}
                    alt={lang === 'es' ? burbuja.titleEs : burbuja.titleEn}
                    width={256}
                    height={256}
                    widths={[96, 128, 192, 256]}
                    sizes="(max-width: 640px) 96px, (max-width: 768px) 112px, 128px"
                    format="webp"
                    quality={80}
                    class="w-full h-full object-cover"
                    loading={isEager ? "eager" : "lazy"}
                    decoding={isEager ? "sync" : "async"}
                  />
                </div>
                <h3 class="text-sm sm:text-base md:text-lg font-semibold text-slate-900 dark:text-white text-center px-2">
                  {lang === 'es' ? burbuja.titleEs : burbuja.titleEn}
                </h3>
              </a>
            );
          })}
        </div>
      </div>
    </section>
    )}

    <!-- Sección 6: Lectura Fácil -->
    {lecturaFacil?.visible && (
      <section id="transcripcion-lectura-facil" class="min-h-[100dvh] bg-white dark:bg-slate-900 pt-24 pb-12 sm:pt-28 sm:pb-16 md:pt-32 md:pb-20 flex items-center">
        <div class="w-full px-4 sm:container sm:mx-auto sm:max-w-4xl">
          <div class="text-center mb-8">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">
              {t.virtualOffice.lecturaFacil.title}
            </h2>
            {lecturaFacil.subtitleLecturaFacil && (
              <div class="text-xl sm:text-2xl md:text-3xl text-slate-600 dark:text-slate-300 pb-12 sm:pb-16 md:pb-20 subtitle-lectura-facil [&_ul]:list-disc [&_ul]:list-outside [&_ul]:pl-6 [&_ul]:mt-2 [&_ul]:mb-0 [&_ul]:text-left [&_li]:ml-0" set:html={lecturaFacil.subtitleLecturaFacil} />
            )}
            <button
              id="toggle-lectura-facil"
              class="text-lg sm:text-xl md:text-2xl font-semibold text-white dark:text-slate-900 bg-SM-blue dark:bg-SM-yellow hover:bg-blue-700 dark:hover:bg-yellow-400 transition-all cursor-pointer inline-flex items-center gap-2 sm:gap-3 px-6 py-3 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 active:scale-95"
              aria-expanded="false"
              aria-controls="contenido-lectura-facil"
            >
              <span>{t.virtualOffice.lecturaFacil.tapToRead}</span>
              <svg id="icon-lectura-facil" class="w-6 h-6 sm:w-8 sm:h-8 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>

          <!-- Contenido de lectura fácil (inicialmente oculto) -->
          <div id="contenido-lectura-facil" class="hidden bg-slate-50 dark:bg-slate-800 rounded-xl sm:rounded-2xl p-6 sm:p-8 md:p-12 shadow-lg transition-all duration-500 ease-in-out">
            <div class="prose prose-base sm:prose-lg dark:prose-invert max-w-none lectura-facil-content [&_ul]:list-disc [&_ul]:pl-8 [&_li]:list-item">
              <div class="space-y-4 sm:space-y-6 text-base sm:text-lg leading-relaxed" set:html={lecturaFacil.content} />
            </div>
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  /* Scroll suave */
  html {
    scroll-behavior: smooth;
  }

  /* Animaciones */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }

  .fade-out-hero {
    animation: fade-out 1s ease-out forwards;
    pointer-events: none;
  }

  /* Estilos para lectura fácil */
  .lectura-facil-content {
    font-size: 1.125rem;
    line-height: 1.8;
    letter-spacing: 0.01em;
  }

  .lectura-facil-content p {
    margin-bottom: 1.5rem;
  }

  /* Forzar bullets visibles con mayor especificidad */
  .lectura-facil-content ul {
    list-style-type: disc !important;
    list-style-position: outside !important;
    padding-left: 2.5rem !important;
    margin-bottom: 1.5rem;
  }

  .lectura-facil-content ul li {
    display: list-item !important;
    list-style-type: disc !important;
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }

  /* Sobrescribir estilos de prose que puedan ocultar bullets */
  .prose.lectura-facil-content ul {
    list-style-type: disc !important;
    padding-left: 2.5rem !important;
  }

  .prose.lectura-facil-content ul li {
    list-style-type: disc !important;
  }

  .prose.lectura-facil-content ul li::marker {
    color: currentColor !important;
  }

  /* Estilos para subtitleLecturaFacil - centrar contenido */
  .subtitle-lectura-facil {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Alinear todo el texto a la izquierda cuando hay listas */
  .subtitle-lectura-facil:has(ul) {
    align-items: flex-start;
    text-align: left;
    max-width: max-content;
    margin: 0 auto;
  }

  /* Mejoras de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .animate-bounce,
    .animate-fade-in-up {
      animation: none;
    }
  }

  /* Estilos de gradiente para el banner CTA según el tema */
  .banner-cta {
    background: linear-gradient(to right, #0072c0, #1d4ed8); /* blue por defecto */
  }

  .banner-cta[data-theme="blue"] {
    background: linear-gradient(to right, #0072c0, #1d4ed8);
  }

  .banner-cta[data-theme="emerald"] {
    background: linear-gradient(to right, #047857, #065f46);
  }

  .banner-cta[data-theme="yellow"] {
    background: linear-gradient(to right, #f8c200, #d97706);
  }

  /* Modo oscuro */
  .dark .banner-cta[data-theme="blue"] {
    background: linear-gradient(to right, #1e40af, #1e3a8a);
  }

  .dark .banner-cta[data-theme="emerald"] {
    background: linear-gradient(to right, #064e3b, #022c22);
  }

  .dark .banner-cta[data-theme="yellow"] {
    background: linear-gradient(to right, #b45309, #92400e);
  }

  /* Asegurar que el video sea responsive */
  #vertical-video {
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* En móviles, ajustar el video para formato vertical */
  @media (max-width: 768px) and (orientation: portrait) {
    #vertical-video {
      width: 100%;
      height: auto;
      object-fit: contain;
      background: #000;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Fade out del título y sombreado después de 2s (escritorio) o 4s (móvil)
    const heroTitle = document.getElementById('hero-title');
    const heroOverlay = document.getElementById('hero-overlay');

    if (heroTitle && heroOverlay) {
      // Detectar si es escritorio (ancho >= 768px)
      const isDesktop = window.innerWidth >= 768;
      const fadeOutDelay = isDesktop ? 2000 : 4000; // 2s escritorio, 4s móvil

      setTimeout(() => {
        heroTitle.classList.add('fade-out-hero');
        heroOverlay.classList.add('fade-out-hero');
      }, fadeOutDelay);
    }

    // Toggle para contenido de Lectura Fácil
    const toggleButton = document.getElementById('toggle-lectura-facil');
    const contenido = document.getElementById('contenido-lectura-facil');
    const icon = document.getElementById('icon-lectura-facil');

    if (toggleButton && contenido && icon) {
      toggleButton.addEventListener('click', () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          // Colapsar
          contenido.classList.add('hidden');
          toggleButton.setAttribute('aria-expanded', 'false');
          icon.style.transform = 'rotate(0deg)';
        } else {
          // Expandir
          contenido.classList.remove('hidden');
          toggleButton.setAttribute('aria-expanded', 'true');
          icon.style.transform = 'rotate(180deg)';

          // Scroll suave al contenido después de expandir
          setTimeout(() => {
            contenido.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }, 100);
        }
      });
    }
  });
</script>
