---
// Layout reutilizable para menús de aventuras gamificadas
import Layout from '../components/Layout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';

// Importar componente Image y getImage de Astro para optimización automática
import { Image, getImage } from 'astro:assets';

// Importar imágenes de tipos de aventura (PNG para mejor calidad)
import imgSubtitulada from '../assets/images/icons/subtitulada.png';
import imgLecturaFacil from '../assets/images/icons/lectura-facil.png';
import imgEnglish from '../assets/images/icons/english.png';
import imgEspanol from '../assets/images/icons/espanol.png';
import imgDescriptiva from '../assets/images/icons/descriptiva.png';
import imgAventuraEsp from '../assets/images/icons/aventura_esp.png';
import imgAventuraEng from '../assets/images/icons/aventura_eng.png';

// Importar imágenes hero disponibles
import imgHeroSantaMarta from '../assets/images/main_page/santa marta explora.png';
import imgHeroSantaMartaDesktop from '../assets/images/adventures/SMX_desktop.png';
import imgHeroUrbanEscape from '../assets/images/adventures/SMUrban.jpg';
import imgHeroUrbanEscapeDesktop from '../assets/images/adventures/SMUrban_desktop.png';
import imgHeroDetectivesDesktop from '../assets/images/adventures/detectives_desktop.png';

interface Props {
  config: any; // Configuración desde content collection o props directas
}

const { config } = Astro.props;
const {
  title,
  description,
  hero,
  subtitle,
  adventureCards,
  showFooter = true,
} = config;

// Este template siempre se muestra en español
const lang = 'es';

// Calcular URL para el cambio de idioma
// En los menús de aventura, el botón "English" debe llevar a la versión /ingles de la aventura
const currentPath = Astro.url.pathname;
const languageSwitchUrl = `${currentPath.replace(/\/$/, '')}/ingles`;

// Mapa de imágenes hero disponibles (móvil)
const heroImages = {
  'santa-marta-explora': imgHeroSantaMarta,
  'urban-escape': imgHeroUrbanEscape,
  'detectives-accion': imgHeroDetectivesDesktop, // Usando la misma imagen desktop para móvil temporalmente
};

// Mapa de imágenes hero para desktop (raw imports)
const heroImagesDesktop = {
  'santa-marta-explora': imgHeroSantaMartaDesktop,
  'urban-escape': imgHeroUrbanEscapeDesktop,
  'detectives-accion': imgHeroDetectivesDesktop,
};

// Procesar imágenes desktop con getImage para optimización
const processedDesktopImages = hero?.imageKey && heroImagesDesktop[hero.imageKey]
  ? await getImage({
      src: heroImagesDesktop[hero.imageKey],
      width: 3440,
      height: 1440,
      format: 'webp',
      quality: 80,
    })
  : null;

// Mapa de imágenes para los tipos de aventura
const adventureTypeImages = {
  'subtitulada': imgSubtitulada,
  'lectura-facil': imgLecturaFacil,
  'english': imgEnglish,
  'espanol': imgEspanol,
  'descriptiva': imgDescriptiva,
  'aventura-esp': imgAventuraEsp,
  'aventura-eng': imgAventuraEng,
};

// Todos los badges usan el color azul del tema (#0072c0)
const badgeColors = {
  'subtitulada': 'bg-SM-blue',
  'lectura-facil': 'bg-SM-blue',
  'english': 'bg-SM-blue',
  'espanol': 'bg-SM-blue',
  'descriptiva': 'bg-SM-blue',
  'aventura-esp': 'bg-SM-blue',
  'aventura-eng': 'bg-SM-blue',
};

// Textos para los badges
const badgeTexts = {
  'espanol': 'Español',
  'lectura-facil': 'LF',
  'descriptiva': 'Detallado',
  'subtitulada': 'Subtitulado',
  'english': 'English',
  'aventura-esp': 'Español',
  'aventura-eng': 'English',
};
---

<Layout
  title={title}
  description={description}
  lang={lang}
>
  <Header currentPage="aventuras" lang={lang} languageSwitchUrl={languageSwitchUrl} />

  <main id="main-content" class="flex-1">
    <!-- Sección Hero con imagen -->
    {hero?.visible && (
      <section id="hero-section" class="relative h-[50vh] sm:h-[60vh] md:h-[70vh] w-full overflow-hidden bg-slate-900">
        <!-- Imagen de fondo responsive -->
        {hero.imageKey && heroImages[hero.imageKey] && (
          <div class="absolute inset-0">
            <picture>
              {/* Imagen optimizada para desktop (procesada con Sharp) */}
              {processedDesktopImages && (
                <source
                  media="(min-width: 768px)"
                  srcset={processedDesktopImages.src}
                  type="image/webp"
                />
              )}
              {/* Imagen para móvil (procesada automáticamente por Image) */}
              <Image
                src={heroImages[hero.imageKey]}
                alt={hero.imageAlt || ''}
                width={1200}
                height={1200}
                widths={[600, 1200, 1800]}
                sizes="100vw"
                format="webp"
                quality={80}
                class="w-full h-full object-cover"
                loading="eager"
                decoding="sync"
              />
            </picture>
          </div>
        )}

        <!-- Botón de scroll si hay más contenido -->
        {(subtitle?.visible || adventureCards?.visible) && (
          <button
            onclick="document.getElementById('adventure-menu').scrollIntoView({ behavior: 'smooth', block: 'start' })"
            class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 p-2 animate-bounce bg-white/20 rounded-full backdrop-blur-sm hover:bg-white/30 transition-colors"
            aria-label="Desplazarse al menú de aventuras"
          >
            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </button>
        )}
      </section>
    )}

    <!-- Sección de Subtítulo opcional -->
    {subtitle?.visible && (
      <section id="adventure-subtitle" class="bg-white dark:bg-slate-900 py-8 sm:py-12">
        <div class="container mx-auto px-4 max-w-4xl">
          <div class="text-center">
            <p class="text-lg sm:text-xl md:text-2xl text-slate-600 dark:text-slate-300" set:html={subtitle.text} />
          </div>
        </div>
      </section>
    )}

    <!-- Sección de Tarjetas de Aventura -->
    {adventureCards?.visible && (
      <section id="adventure-menu" class="bg-slate-50 dark:bg-slate-800 py-12 sm:py-16 md:py-20">
        <div class="container mx-auto px-4 max-w-7xl">
          <!-- Título de la sección -->
          {adventureCards.sectionTitle && (
            <div class="text-center mb-8 sm:mb-12">
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3">
                {adventureCards.sectionTitle}
              </h2>
              {adventureCards.sectionSubtitle && (
                <p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300">
                  {adventureCards.sectionSubtitle}
                </p>
              )}
            </div>
          )}

          <!-- Grid de tarjetas en 2 columnas (mobile-first) -->
          <div class="grid grid-cols-2 gap-3 md:gap-6 max-w-4xl mx-auto">
            {adventureCards.cards?.map((card: any, index: number) => {
              const typeImage = adventureTypeImages[card.type];
              const badgeColor = badgeColors[card.type] || 'bg-gray-600';
              const badgeText = badgeTexts[card.type] || card.type;

              // Las primeras 4 tarjetas se cargan con prioridad (2 filas visibles en móvil)
              const isEager = index < 4;
              const loading = isEager ? "eager" : "lazy";

              return (
                <a
                  href={card.link}
                  class="group block h-full bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-xl hover:scale-[1.02] transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-blue-500 focus:ring-opacity-50"
                  aria-label={`${card.title} - ${badgeText}`}
                >
                  <div class="h-full flex flex-col aspect-square">
                    <!-- Imagen optimizada -->
                    <div class="relative flex-shrink-0 h-[70%] md:h-[75%] min-h-[100px] md:min-h-[120px] bg-slate-100 dark:bg-slate-700">
                      {typeImage && (
                        <Image
                          src={typeImage}
                          alt={card.imageAlt || card.title}
                          width={500}
                          height={500}
                          densities={[1, 2]}
                          format="webp"
                          quality={85}
                          class="w-full h-full object-cover"
                          loading={loading}
                          decoding="async"
                        />
                      )}

                      <!-- Badge -->
                      <div class="absolute top-4 left-4">
                        <span class={`px-3 py-1.5 text-sm md:text-base font-medium rounded-full ${badgeColor} text-white`}>
                          {badgeText}
                        </span>
                      </div>
                    </div>

                    <!-- Contenido de texto -->
                    <div class="p-2 md:p-3 flex-grow flex flex-col justify-center">
                      <h3 class="font-semibold text-sm md:text-lg text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight md:leading-tight break-words">
                        {card.title}
                      </h3>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- Mensaje si no hay tarjetas configuradas -->
          {(!adventureCards.cards || adventureCards.cards.length === 0) && (
            <div class="text-center py-12">
              <p class="text-lg text-slate-500 dark:text-slate-400">
                No hay aventuras disponibles en este momento.
              </p>
            </div>
          )}
        </div>
      </section>
    )}
  </main>

  {showFooter && <Footer lang={lang} />}
</Layout>

<style>
  /* Animaciones */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }

  /* Mejoras de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .animate-bounce,
    .animate-fade-in-up {
      animation: none;
    }

    .hover\:scale-\[1\.02\] {
      transform: none !important;
    }
  }

  /* Focus visible para accesibilidad con teclado */
  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #3b82f6;
    outline-offset: 2px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Animación de aparición progresiva de las tarjetas
    const cards = document.querySelectorAll('#adventure-menu .group');

    if (cards.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                entry.target.classList.add('animate-fade-in-up');
              }, index * 100);
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        }
      );

      cards.forEach(card => {
        card.style.opacity = '0';
        observer.observe(card);
      });
    }
  });
</script>