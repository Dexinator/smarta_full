---
// English Main Page - Santa Marta Smart Tourism
import Layout from '../../components/Layout.astro';
import Header from '../../components/ui/Header.astro';
import Footer from '../../components/ui/Footer.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import TouristInfo from '../../components/sections/TouristInfo.astro';
import AudioGuides from '../../components/sections/AudioGuides.astro';
import GamifiedAdventures from '../../components/sections/GamifiedAdventures.astro';
import PublicFunding from '../../components/sections/PublicFunding.astro';
---

<Layout
  title="Santa Marta Smart Tourism | Discover, Explore, Experience"
  description="Smart tourism portal for Santa Marta de Tormes. Interactive audio guides, tourist information, gamified adventures and unique experiences."
  lang="en"
>
  <Header currentPage="home" lang="en" />

  <main id="main-content" class="flex-1">
    <!-- Hero Section with navigation -->
    <HeroSection lang="en" />

    <!-- Tourist Information Section (4 options) -->
    <TouristInfo lang="en" />

    <!-- Audio Guides Section (2 options) -->
    <AudioGuides lang="en" />

    <!-- Gamified Adventures Section (3 options) -->
    <GamifiedAdventures lang="en" />

    <!-- Public Funding Section -->
    <PublicFunding lang="en" />
  </main>

  <Footer lang="en" />
</Layout>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Scroll snap adjustments for mobile */
  @media (max-width: 768px) {
    main {
      scroll-snap-type: y mandatory;
    }

    main > section {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }
</style>

<script>
  // Handle hash navigation for mobile devices
  document.addEventListener('DOMContentLoaded', () => {
    // Function to scroll to an element by its ID
    function scrollToHash(hash: string) {
      const targetId = hash.replace('#', '');
      const targetElement = document.getElementById(targetId);

      if (targetElement) {
        // Small delay to ensure content is rendered
        setTimeout(() => {
          // On mobile, temporarily disable scroll-snap to allow scrolling
          const main = document.querySelector('main');
          if (main && window.innerWidth <= 768) {
            const originalScrollSnapType = getComputedStyle(main).scrollSnapType;
            main.style.scrollSnapType = 'none';

            // Scroll to element
            targetElement.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });

            // Re-enable scroll-snap after scrolling
            setTimeout(() => {
              main.style.scrollSnapType = originalScrollSnapType;
            }, 1000);
          } else {
            // On desktop, normal scroll
            targetElement.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        }, 100);
      }
    }

    // Detect if there's a hash in the URL on page load
    if (window.location.hash) {
      scrollToHash(window.location.hash);
    }

    // Intercept clicks on links with hash
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest('a');

      if (link && link.hash && link.pathname === window.location.pathname) {
        e.preventDefault();
        scrollToHash(link.hash);
        // Update URL without reloading
        history.pushState(null, '', link.hash);
      }
    });
  });
</script>
