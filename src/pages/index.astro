---
// Página principal - Santa Marta Turismo Inteligente
import Layout from '../components/Layout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TouristInfo from '../components/sections/TouristInfo.astro';
import AudioGuides from '../components/sections/AudioGuides.astro';
import GamifiedAdventures from '../components/sections/GamifiedAdventures.astro';
import PublicFunding from '../components/sections/PublicFunding.astro';
---

<Layout
  title="Descubre todo lo que Santa Marta tiene para ofrecerte"
  description="Explora arte urbano, naturaleza, aventuras y experiencias únicas. Santa Marta de Tormes te invita a vivir la cultura, el arte y la naturaleza de una forma diferente, a tu ritmo y con todas las facilidades."
  lang="es"
>
  <Header currentPage="home" lang="es" />

  <main id="main-content" class="flex-1">
    <!-- Hero Section con navegación -->
    <HeroSection lang="es" />

    <!-- Sección de Información Turística (4 opciones) -->
    <TouristInfo lang="es" />

    <!-- Sección de Audioguías (2 opciones) -->
    <AudioGuides lang="es" />

    <!-- Sección de Aventuras Gamificadas (3 opciones) -->
    <GamifiedAdventures lang="es" />

    <!-- Sección de Financiación Pública -->
    <PublicFunding lang="es" />
  </main>

  <Footer lang="es" />
</Layout>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Ajustes para scroll snap en móviles */
  @media (max-width: 768px) {
    main {
      scroll-snap-type: y mandatory;
    }

    main > section {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }
</style>

<script>
  // Manejo de navegación con hash para móviles
  document.addEventListener('DOMContentLoaded', () => {
    // Función para hacer scroll a un elemento por su ID
    function scrollToHash(hash: string) {
      const targetId = hash.replace('#', '');
      const targetElement = document.getElementById(targetId);

      if (targetElement) {
        // Pequeño delay para asegurar que el contenido esté renderizado
        setTimeout(() => {
          // En móviles, desactivar temporalmente scroll-snap para permitir el scroll
          const main = document.querySelector('main');
          if (main && window.innerWidth <= 768) {
            const originalScrollSnapType = getComputedStyle(main).scrollSnapType;
            main.style.scrollSnapType = 'none';

            // Hacer scroll al elemento
            targetElement.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });

            // Reactivar scroll-snap después del scroll
            setTimeout(() => {
              main.style.scrollSnapType = originalScrollSnapType;
            }, 1000);
          } else {
            // En desktop, scroll normal
            targetElement.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        }, 100);
      }
    }

    // Detectar si hay un hash en la URL al cargar la página
    if (window.location.hash) {
      scrollToHash(window.location.hash);
    }

    // Interceptar clicks en links con hash
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest('a');

      if (link && link.hash && link.pathname === window.location.pathname) {
        e.preventDefault();
        scrollToHash(link.hash);
        // Actualizar la URL sin recargar
        history.pushState(null, '', link.hash);
      }
    });
  });
</script>