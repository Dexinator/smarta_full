---
// Versión Lectura Fácil de la aventura "El Misterio de la Isla del Soto"
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/ui/Header.astro';
import Footer from '../../../components/ui/Footer.astro';

const lang = 'es';
---

<Layout
  title="El Misterio de la Isla del Soto - Lectura Fácil"
  description="Aventura adaptada con textos simplificados y estructura clara"
  lang={lang}
>
  <Header currentPage="aventuras" lang={lang} />

  <main class="flex-1">
    <!-- Hero de la aventura -->
    <section class="bg-gradient-to-b from-green-700 to-green-600 py-20 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          El Misterio de la Isla
        </h1>
        <p class="text-xl mb-2">Lectura Fácil</p>
        <div class="inline-block bg-green-500 text-white px-4 py-2 rounded-full text-sm font-semibold">
          Textos sencillos
        </div>
      </div>
    </section>

    <!-- Contenido de ejemplo en Lectura Fácil -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="bg-green-50 rounded-xl p-8 shadow-lg">
          <h2 class="text-3xl font-bold mb-8 text-slate-900">
            Capítulo 1
          </h2>

          <!-- Contenido simplificado con pictogramas -->
          <div class="space-y-8 lectura-facil-content">
            <div class="bg-white rounded-lg p-6 border-4 border-green-300">
              <div class="flex items-center gap-4 mb-4">
                <span class="text-5xl">🏝️</span>
                <h3 class="text-2xl font-bold">Estás en la Isla del Soto</h3>
              </div>
              <p class="text-xl leading-relaxed text-slate-700">
                La isla es muy bonita.
              </p>
              <p class="text-xl leading-relaxed text-slate-700 mt-3">
                Tiene árboles y un río.
              </p>
            </div>

            <div class="bg-white rounded-lg p-6 border-4 border-blue-300">
              <div class="flex items-center gap-4 mb-4">
                <span class="text-5xl">🔍</span>
                <h3 class="text-2xl font-bold">Hay un misterio</h3>
              </div>
              <p class="text-xl leading-relaxed text-slate-700">
                Algo extraño pasa en la isla.
              </p>
              <p class="text-xl leading-relaxed text-slate-700 mt-3">
                Tú vas a descubrir qué es.
              </p>
            </div>

            <div class="bg-yellow-100 rounded-lg p-8 border-4 border-yellow-400">
              <h3 class="text-2xl font-bold mb-6 text-slate-900">
                ¿Qué quieres hacer?
              </h3>
              <div class="space-y-4">
                <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold text-xl py-4 px-6 rounded-xl transition-colors flex items-center gap-4">
                  <span class="text-3xl">🌳</span>
                  <span>Ir al bosque</span>
                </button>
                <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold text-xl py-4 px-6 rounded-xl transition-colors flex items-center gap-4">
                  <span class="text-3xl">💧</span>
                  <span>Ir al río</span>
                </button>
                <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold text-xl py-4 px-6 rounded-xl transition-colors flex items-center gap-4">
                  <span class="text-3xl">🏛️</span>
                  <span>Ir al centro</span>
                </button>
              </div>
            </div>

            <!-- Ayuda visual adicional -->
            <div class="bg-purple-100 rounded-lg p-6 border-4 border-purple-300">
              <div class="flex items-center gap-4">
                <span class="text-4xl">💡</span>
                <p class="text-lg font-medium text-slate-700">
                  Consejo: Piensa bien antes de elegir
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Controles simplificados -->
        <div class="mt-8 flex flex-col gap-4">
          <button class="bg-orange-500 hover:bg-orange-600 text-white font-bold text-xl py-4 px-6 rounded-xl transition-colors flex items-center justify-center gap-3">
            <span class="text-2xl">⏸️</span>
            <span>Parar el juego</span>
          </button>
          <a href="/aventuras/isla-misterio" class="bg-red-500 hover:bg-red-600 text-white font-bold text-xl py-4 px-6 rounded-xl transition-colors flex items-center justify-center gap-3">
            <span class="text-2xl">←</span>
            <span>Volver</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  /* Estilos específicos para lectura fácil */
  .lectura-facil-content {
    font-size: 1.25rem;
    line-height: 1.8;
    letter-spacing: 0.02em;
  }

  .lectura-facil-content p {
    font-weight: 500;
  }
</style>