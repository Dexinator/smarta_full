---
// English version of the adventure "The Mystery of Soto Island"
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/ui/Header.astro';
import Footer from '../../../components/ui/Footer.astro';

const lang = 'en';
---

<Layout
  title="The Mystery of Soto Island - English Version"
  description="Interactive adventure game in English"
  lang={lang}
>
  <Header currentPage="adventures" lang={lang} />

  <main class="flex-1">
    <!-- Adventure Hero -->
    <section class="bg-gradient-to-b from-purple-900 to-purple-700 py-20 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          The Mystery of Soto Island
        </h1>
        <p class="text-xl mb-2">English Version</p>
        <div class="inline-block bg-purple-600 text-white px-4 py-2 rounded-full text-sm font-semibold">
          Full English Experience
        </div>
      </div>
    </section>

    <!-- Adventure Content Example -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="bg-purple-50 rounded-xl p-8 shadow-lg">
          <h2 class="text-2xl font-bold mb-6 text-slate-900">Chapter 1: The Beginning</h2>

          <!-- English content with narrative -->
          <div class="space-y-6">
            <div class="bg-white rounded-lg p-6 border-2 border-purple-200">
              <div class="prose prose-lg max-w-none">
                <p class="text-slate-700">
                  You arrive at Soto Island on a misty morning. The island, nestled in the heart of the Tormes River,
                  holds secrets that have remained hidden for centuries. As you step onto the wooden dock, you can't
                  help but feel that something extraordinary is about to happen.
                </p>
              </div>
            </div>

            <div class="bg-white rounded-lg p-6 border-2 border-indigo-200">
              <div class="flex items-start gap-4">
                <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center flex-shrink-0">
                  <span class="text-3xl">🗺️</span>
                </div>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold mb-2 text-slate-900">Your Inventory:</h3>
                  <ul class="space-y-1 text-slate-700">
                    <li>• A mysterious map with cryptic symbols</li>
                    <li>• A flashlight</li>
                    <li>• A notebook and pen</li>
                    <li>• A compass</li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="bg-gradient-to-r from-purple-100 to-indigo-100 rounded-lg p-6 border-2 border-purple-300">
              <h3 class="text-lg font-bold mb-4 text-slate-900">Make Your Choice:</h3>
              <p class="text-slate-700 mb-4">
                The island stretches before you, full of possibilities. Where will you begin your investigation?
              </p>
              <div class="space-y-3">
                <button class="w-full bg-purple-600 hover:bg-purple-700 text-white font-medium py-3 px-6 rounded-lg transition-all transform hover:scale-105 text-left">
                  <span class="font-bold">Option A:</span> Follow the forest trail into the dense woodland
                </button>
                <button class="w-full bg-purple-600 hover:bg-purple-700 text-white font-medium py-3 px-6 rounded-lg transition-all transform hover:scale-105 text-left">
                  <span class="font-bold">Option B:</span> Explore the riverbank for clues
                </button>
                <button class="w-full bg-purple-600 hover:bg-purple-700 text-white font-medium py-3 px-6 rounded-lg transition-all transform hover:scale-105 text-left">
                  <span class="font-bold">Option C:</span> Visit the interpretation center for information
                </button>
              </div>
            </div>

            <!-- Game tip -->
            <div class="bg-blue-50 rounded-lg p-4 border-l-4 border-blue-500">
              <div class="flex items-center gap-3">
                <span class="text-2xl">💡</span>
                <p class="text-sm text-slate-600 italic">
                  Tip: Your choices affect the story. Each path reveals different clues about the island's mystery.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Game Controls -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <button class="bg-slate-600 hover:bg-slate-700 text-white font-medium py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2">
            <span>⏸️</span> Pause Game
          </button>
          <button class="bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2">
            <span>⚙️</span> Settings
          </button>
          <a href="/aventuras/isla-misterio" class="bg-red-600 hover:bg-red-700 text-white font-medium py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2">
            <span>🔙</span> Back to Menu
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>