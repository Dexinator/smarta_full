---
// Versión subtitulada de "La Búsqueda de los Murales Perdidos"
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/ui/Header.astro';
import Footer from '../../../components/ui/Footer.astro';

const lang = 'es';
---

<Layout
  title="La Búsqueda de los Murales Perdidos - Versión Subtitulada"
  description="Juego interactivo con subtítulos sobre los murales de Santa Marta"
  lang={lang}
>
  <Header currentPage="aventuras" lang={lang} />

  <main class="flex-1">
    <section class="bg-gradient-to-b from-orange-800 to-orange-600 py-20 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          La Búsqueda de los Murales Perdidos
        </h1>
        <p class="text-xl mb-2">Versión Subtitulada</p>
        <div class="inline-block bg-orange-700 text-white px-4 py-2 rounded-full text-sm font-semibold">
          Con subtítulos completos
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="bg-orange-50 rounded-xl p-8 shadow-lg text-center">
          <h2 class="text-3xl font-bold mb-6 text-slate-900">¡Aventura en desarrollo!</h2>
          <p class="text-lg text-slate-700 mb-8">
            Esta emocionante aventura sobre los murales de Santa Marta estará disponible próximamente.
          </p>
          <div class="bg-white rounded-lg p-6 inline-block">
            <span class="text-6xl">🎨</span>
            <p class="mt-4 text-slate-600">
              Descubre los secretos ocultos en el arte urbano
            </p>
          </div>
          <div class="mt-8">
            <a href="/aventuras/ruta-murales" class="bg-orange-600 hover:bg-orange-700 text-white font-medium py-3 px-8 rounded-lg transition-colors inline-block">
              Volver al menú
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>