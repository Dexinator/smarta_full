---
// Versión Lectura Fácil de "La Búsqueda de los Murales Perdidos"
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/ui/Header.astro';
import Footer from '../../../components/ui/Footer.astro';

const lang = 'es';
---

<Layout
  title="Los Murales Perdidos - Lectura Fácil"
  description="Juego sencillo sobre los murales"
  lang={lang}
>
  <Header currentPage="aventuras" lang={lang} />

  <main class="flex-1">
    <section class="bg-gradient-to-b from-green-700 to-green-600 py-20 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          Los Murales
        </h1>
        <p class="text-xl mb-2">Lectura Fácil</p>
        <div class="inline-block bg-green-500 text-white px-4 py-2 rounded-full text-sm font-semibold">
          Textos sencillos
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="bg-green-50 rounded-xl p-8 shadow-lg text-center">
          <h2 class="text-3xl font-bold mb-6 text-slate-900">Pronto estará listo</h2>
          <div class="bg-white rounded-lg p-8 inline-block">
            <span class="text-7xl">🎨</span>
            <p class="mt-4 text-xl font-medium text-slate-700">
              El juego de los murales
            </p>
            <p class="mt-2 text-xl text-slate-600">
              Va a ser muy divertido
            </p>
          </div>
          <div class="mt-8">
            <a href="/aventuras/ruta-murales" class="bg-green-600 hover:bg-green-700 text-white font-bold text-xl py-4 px-8 rounded-xl transition-colors inline-block">
              ← Volver
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>