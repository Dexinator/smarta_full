<script>
  document.addEventListener('DOMContentLoaded', () => {
    const galleries = document.querySelectorAll('.adventure-gallery-wrapper');

    galleries.forEach(wrapper => {
      const gallery = wrapper.querySelector('.adventure-gallery-container');
      const galleryWrapper = gallery.querySelector('.gallery-wrapper');
      const carousel = gallery.querySelector('.gallery-carousel');
      const track = gallery.querySelector('.gallery-track');
      const slides = gallery.querySelectorAll('.gallery-slide');
      const prevButton = galleryWrapper.querySelector('.gallery-prev');
      const nextButton = galleryWrapper.querySelector('.gallery-next');
      const indicators = gallery.querySelectorAll('.indicator');
      const mediaButtons = gallery.querySelectorAll('.media-button');
      const fullscreenButton = wrapper.querySelector('.fullscreen-button');
      const exitFullscreenButton = gallery.querySelector('.exit-fullscreen-button');

      if (!carousel || !track || slides.length === 0) return;

      let currentIndex = 0;
      const totalSlides = slides.length;

      // Variable para rastrear si estábamos en pantalla completa antes del modal
      let wasInFullscreenBeforeModal = false;

      // Función para actualizar la posición del carousel
      const updateCarousel = (index, smooth = true) => {
        if (index < 0 || index >= totalSlides) return;

        currentIndex = index;

        // Marcar la slide activa
        slides.forEach((slide, i) => {
          if (i === currentIndex) {
            slide.classList.add('active-slide');
          } else {
            slide.classList.remove('active-slide');
          }
        });

        // Verificar si estamos en pantalla completa
        const isFullscreen = gallery.classList.contains('fullscreen-active');

        // En desktop usar transform, en móvil usar scroll
        if (window.innerWidth > 768 && !isFullscreen) {
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        } else {
          // En móvil o en fullscreen usar scroll nativo
          // Usar requestAnimationFrame para asegurar que el layout está actualizado
          requestAnimationFrame(() => {
            const slideWidth = carousel.offsetWidth;

            // Verificación adicional del ancho
            if (slideWidth === 0) {
              console.warn('Carousel width is 0, trying viewport width');
              const viewportWidth = window.innerWidth;
              const targetScroll = viewportWidth * currentIndex;
              carousel.scrollTo({
                left: targetScroll,
                behavior: smooth ? 'smooth' : 'instant'
              });
            } else {
              const targetScroll = slideWidth * currentIndex;
              console.log(`Navigating to slide ${currentIndex}, width: ${slideWidth}, scroll: ${targetScroll}`);

              carousel.scrollTo({
                left: targetScroll,
                behavior: smooth ? 'smooth' : 'instant'
              });
            }
          });
        }

        // Actualizar botones de navegación
        if (prevButton) prevButton.disabled = currentIndex === 0;
        if (nextButton) nextButton.disabled = currentIndex === totalSlides - 1;

        // Actualizar indicadores
        indicators.forEach((indicator, i) => {
          if (i === currentIndex) {
            indicator.classList.add('bg-white', 'w-8');
            indicator.classList.remove('bg-white/50', 'w-2');
            indicator.setAttribute('aria-selected', 'true');
          } else {
            indicator.classList.remove('bg-white', 'w-8');
            indicator.classList.add('bg-white/50', 'w-2');
            indicator.setAttribute('aria-selected', 'false');
          }
        });
      };

      // Event listeners para botones de navegación
      prevButton?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        if (currentIndex > 0) {
          // Activar flag de navegación manual
          isManualNavigation = true;
          console.log('Previous button clicked, manual navigation enabled');

          updateCarousel(currentIndex - 1);

          // Desactivar después de que termine la animación
          setTimeout(() => {
            isManualNavigation = false;
            console.log('Manual navigation disabled');
          }, 800);
        }
      });

      nextButton?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        if (currentIndex < totalSlides - 1) {
          // Activar flag de navegación manual
          isManualNavigation = true;
          console.log('Next button clicked, manual navigation enabled');

          updateCarousel(currentIndex + 1);

          // Desactivar después de que termine la animación
          setTimeout(() => {
            isManualNavigation = false;
            console.log('Manual navigation disabled');
          }, 800);
        }
      });

      // Event listeners para indicadores
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          // Activar flag de navegación manual
          isManualNavigation = true;
          console.log(`Indicator ${index} clicked, manual navigation enabled`);

          updateCarousel(index);

          // Desactivar después de que termine la animación
          setTimeout(() => {
            isManualNavigation = false;
            console.log('Manual navigation disabled');
          }, 800);
        });
      });

      // Sistema simplificado de navegación para móvil con scroll nativo
      let scrollTimer = null;
      let isScrolling = false;
      let lastScrollLeft = 0;
      let isManualNavigation = false; // Flag para navegación manual con flechas

      const handleMobileScroll = () => {
        // Solo procesar en móvil O en modo fullscreen (que siempre usa scroll)
        const isFullscreen = gallery.classList.contains('fullscreen-active');
        if (window.innerWidth > 768 && !isFullscreen) return;

        // Si estamos navegando manualmente con flechas, ignorar el scroll event temporalmente
        if (isManualNavigation) {
          console.log('Manual navigation in progress, ignoring scroll event');
          return;
        }

        isScrolling = true;

        // Guardar la posición actual del scroll
        lastScrollLeft = carousel.scrollLeft;

        // Clear timer anterior
        clearTimeout(scrollTimer);

        // Set timer para detectar fin del scroll
        scrollTimer = setTimeout(() => {
          // IMPORTANTE: Verificar nuevamente si estamos en navegación manual
          // porque el flag puede haber cambiado durante el timeout
          if (isManualNavigation) {
            console.log('Manual navigation still active, skipping index update');
            isScrolling = false;
            return;
          }

          isScrolling = false;

          // Calcular el índice actual basado en la posición del scroll
          const slideWidth = carousel.offsetWidth;
          const scrollPosition = carousel.scrollLeft;

          // Usar Math.round para mejor detección del slide actual
          let newIndex = Math.round(scrollPosition / slideWidth);

          // Asegurar que el índice esté dentro de los límites
          newIndex = Math.max(0, Math.min(newIndex, totalSlides - 1));

          if (newIndex !== currentIndex) {
            console.log(`Scroll handler updating index from ${currentIndex} to ${newIndex}`);
            currentIndex = newIndex;

            // Actualizar todos los elementos UI
            updateUIElements(currentIndex);
          }

          // Asegurar que estamos exactamente en una slide (snap correction)
          const targetScroll = slideWidth * currentIndex;
          if (Math.abs(scrollPosition - targetScroll) > 1) {
            carousel.scrollTo({
              left: targetScroll,
              behavior: 'smooth'
            });
          }
        }, 100); // Reducido a 100ms para mejor respuesta
      };

      // Event listener de scroll - SIEMPRE añadirlo porque se necesita en fullscreen
      carousel.addEventListener('scroll', handleMobileScroll, { passive: true });

      // También escuchar scrollend si está disponible (mejor soporte en navegadores modernos)
      if ('onscrollend' in window) {
        carousel.addEventListener('scrollend', () => {
          // Solo procesar en móvil O en modo fullscreen
          const isFullscreen = gallery.classList.contains('fullscreen-active');
          if (window.innerWidth > 768 && !isFullscreen) return;

          const slideWidth = carousel.offsetWidth;
          const scrollPosition = carousel.scrollLeft;
          const targetIndex = Math.round(scrollPosition / slideWidth);

          // Asegurar que estamos exactamente en una slide
          if (targetIndex >= 0 && targetIndex < totalSlides) {
            carousel.scrollTo({
              left: slideWidth * targetIndex,
              behavior: 'smooth'
            });
          }
        });
      }

      // Navegación con teclado
      carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
          // Activar flag de navegación manual
          isManualNavigation = true;
          console.log('Keyboard navigation, manual navigation enabled');

          if (e.key === 'ArrowLeft') {
            updateCarousel(currentIndex - 1);
          } else if (e.key === 'ArrowRight') {
            updateCarousel(currentIndex + 1);
          }

          // Desactivar después de que termine la animación
          setTimeout(() => {
            isManualNavigation = false;
            console.log('Manual navigation disabled');
          }, 800);
        }
      });

      // Event listeners para botones de media
      const setupMediaButtons = () => {
        const buttons = gallery.querySelectorAll('.media-button');
        buttons.forEach(button => {
          // Remover listeners anteriores para evitar duplicados
          button.replaceWith(button.cloneNode(true));
        });

        // Obtener los botones nuevamente después del clone
        const newButtons = gallery.querySelectorAll('.media-button');
        newButtons.forEach(button => {
          button.addEventListener('click', async (e) => {
            e.stopPropagation();
            e.preventDefault();

            const type = button.dataset.mediaType;
            const url = button.dataset.mediaUrl;

            console.log('Media button clicked:', { type, url }); // Debug

            // Verificar si estamos en pantalla completa
            const isCurrentlyFullscreen = document.fullscreenElement ||
                                         document.webkitFullscreenElement ||
                                         document.mozFullScreenElement ||
                                         document.msFullscreenElement;

            // Si estamos en pantalla completa, guardar estado y salir
            if (isCurrentlyFullscreen) {
              wasInFullscreenBeforeModal = true;
              console.log('Exiting fullscreen to show modal'); // Debug

              try {
                await exitFullscreen();
                // Pequeña pausa para asegurar que salió de fullscreen
                await new Promise(resolve => setTimeout(resolve, 100));
              } catch (err) {
                console.error('Error exiting fullscreen:', err);
              }
            } else {
              wasInFullscreenBeforeModal = false;
            }

            // Disparar evento personalizado para abrir el modal
            window.dispatchEvent(new CustomEvent('openMediaModal', {
              detail: { type, url }
            }));
          });
        });
      };

      // Configurar botones inicialmente
      setupMediaButtons();

      // Listener para cuando se cierre el modal
      window.addEventListener('closeMediaModal', async () => {
        console.log('Modal closed, checking if should return to fullscreen:', wasInFullscreenBeforeModal); // Debug

        // Si estábamos en pantalla completa antes del modal, restaurar
        if (wasInFullscreenBeforeModal) {
          wasInFullscreenBeforeModal = false; // Reset flag

          // Pequeña pausa para asegurar que el modal se cerró completamente
          await new Promise(resolve => setTimeout(resolve, 100));

          try {
            await enterFullscreen();
            console.log('Returned to fullscreen after modal closed'); // Debug
          } catch (err) {
            console.error('Error returning to fullscreen:', err);
          }
        }
      });

      // Funcionalidad de pantalla completa
      const enterFullscreen = async () => {
        try {
          // Usar el índice guardado externamente (fullscreenSavedIndex)
          // NO leer currentIndex aquí porque puede haber sido modificado por scroll events
          const savedIndex = fullscreenSavedIndex;
          console.log(`Entering fullscreen with saved index: ${savedIndex}`);

          // NO volver a activar isManualNavigation - ya fue activado en el event listener

          // Solicitar pantalla completa
          if (gallery.requestFullscreen) {
            await gallery.requestFullscreen();
          } else if (gallery.webkitRequestFullscreen) {
            await gallery.webkitRequestFullscreen();
          } else if (gallery.mozRequestFullScreen) {
            await gallery.mozRequestFullScreen();
          } else if (gallery.msRequestFullscreen) {
            await gallery.msRequestFullscreen();
          }

          gallery.classList.add('fullscreen-active');

          // Para galerías landscape en móviles, forzar orientación horizontal
          const orientation = gallery.dataset.orientation;
          if (orientation === 'landscape' && window.innerWidth <= 768) {
            // Intentar bloquear orientación a horizontal
            if (screen.orientation && screen.orientation.lock) {
              try {
                await screen.orientation.lock('landscape');
                console.log('Orientación bloqueada a landscape');
              } catch (err) {
                console.log('No se pudo bloquear la orientación:', err);
                // Intentar con orientación específica si landscape falla
                try {
                  await screen.orientation.lock('landscape-primary');
                } catch (err2) {
                  console.log('No se pudo bloquear a landscape-primary:', err2);
                }
              }
            }
          }

          // Esperar a que la rotación se complete si es necesario
          await new Promise(resolve => setTimeout(resolve, 150));

          // CRÍTICO: Restaurar el índice guardado INMEDIATAMENTE antes de cualquier otra cosa
          currentIndex = savedIndex;
          console.log(`Current index restored to: ${currentIndex}`);

          // Establecer el scroll INMEDIATAMENTE antes de requestAnimationFrame
          // para evitar que el layout cause un scroll automático
          const viewportWidth = window.innerWidth;
          const targetScroll = viewportWidth * savedIndex;
          console.log(`Setting initial scroll position: viewport=${viewportWidth}, index=${savedIndex}, target=${targetScroll}`);
          carousel.scrollLeft = targetScroll;

          // Usar requestAnimationFrame para asegurar que el layout está actualizado
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              setupMediaButtons();

              // Verificar y reestablecer scroll si es necesario
              const currentScroll = carousel.scrollLeft;
              console.log(`Current scroll after layout: ${currentScroll}, expected: ${targetScroll}`);

              if (Math.abs(currentScroll - targetScroll) > 10) {
                console.log('Scroll drifted, correcting...');
                carousel.scrollLeft = targetScroll;
              }

              // Actualizar indicadores y botones con el índice guardado
              updateUIElements(savedIndex);

              // Verificación adicional después de un momento
              setTimeout(() => {
                const actualScroll = carousel.scrollLeft;
                console.log(`Scroll verification after fullscreen: actual=${actualScroll}, expected=${targetScroll}`);

                if (Math.abs(actualScroll - targetScroll) > 10) {
                  console.log('Correcting scroll position...');
                  carousel.scrollLeft = targetScroll;
                }

                // Verificar que currentIndex no ha sido modificado
                if (currentIndex !== savedIndex) {
                  console.warn(`Index was modified! Restoring from ${currentIndex} to ${savedIndex}`);
                  currentIndex = savedIndex;
                  updateUIElements(savedIndex);
                  carousel.scrollLeft = targetScroll;
                }
              }, 200);

              // Verificación final más tardía
              setTimeout(() => {
                if (currentIndex !== savedIndex || Math.abs(carousel.scrollLeft - targetScroll) > 10) {
                  console.warn(`Final correction needed. Index: ${currentIndex} -> ${savedIndex}, Scroll: ${carousel.scrollLeft} -> ${targetScroll}`);
                  currentIndex = savedIndex;
                  carousel.scrollLeft = targetScroll;
                  updateUIElements(savedIndex);
                }
              }, 500);

              // Reactivar navegación después de que todo esté configurado
              // Usar timeout largo para asegurar que todos los scroll events se procesen primero
              setTimeout(() => {
                isManualNavigation = false;
                console.log(`Fullscreen setup complete, navigation enabled. Final index: ${currentIndex}`);
              }, 1000);
            });
          });

        } catch (err) {
          console.error('Error al entrar en pantalla completa:', err);
          isManualNavigation = false;
        }
      };

      // Función auxiliar para actualizar solo los elementos UI
      const updateUIElements = (index) => {
        // Actualizar botones de navegación
        if (prevButton) prevButton.disabled = index === 0;
        if (nextButton) nextButton.disabled = index === totalSlides - 1;

        // Actualizar indicadores
        indicators.forEach((indicator, i) => {
          if (i === index) {
            indicator.classList.add('bg-white', 'w-8');
            indicator.classList.remove('bg-white/50', 'w-2');
            indicator.setAttribute('aria-selected', 'true');
          } else {
            indicator.classList.remove('bg-white', 'w-8');
            indicator.classList.add('bg-white/50', 'w-2');
            indicator.setAttribute('aria-selected', 'false');
          }
        });

        // Actualizar active-slide
        slides.forEach((slide, i) => {
          if (i === index) {
            slide.classList.add('active-slide');
          } else {
            slide.classList.remove('active-slide');
          }
        });

        // Anunciar cambio de slide para lectores de pantalla
        const liveRegion = wrapper.querySelector('.gallery-live-region');
        if (liveRegion && slides[index]) {
          const img = slides[index].querySelector('img');
          const imgAlt = img ? img.alt : '';

          // Obtener el nombre de la parada desde el índice de navegación
          const navLink = wrapper.querySelector(`.navigation-index-link[data-slide-index="${index}"]`);
          const stopNameElement = navLink ? navLink.querySelector('.stop-name') : null;
          const stopName = stopNameElement ? stopNameElement.textContent.trim() : null;

          // Usar el idioma del documento para el anuncio
          const lang = document.documentElement.lang || 'es';

          // Construir mensaje mejorado con nombre de parada si está disponible
          let message;
          if (stopName) {
            message = lang === 'en'
              ? `${stopName}. Image ${index + 1} of ${totalSlides}: ${imgAlt}`
              : `${stopName}. Imagen ${index + 1} de ${totalSlides}: ${imgAlt}`;
          } else {
            message = lang === 'en'
              ? `Image ${index + 1} of ${totalSlides}: ${imgAlt}`
              : `Imagen ${index + 1} de ${totalSlides}: ${imgAlt}`;
          }

          liveRegion.textContent = message;
        }
      };

      const exitFullscreen = async () => {
        try {
          console.log(`Exiting fullscreen from slide ${currentIndex}`);

          // Deshabilitar temporalmente la navegación manual
          isManualNavigation = true;

          // Primero, desbloquear la orientación si estaba bloqueada
          const orientation = gallery.dataset.orientation;
          if (orientation === 'landscape' && screen.orientation && screen.orientation.unlock) {
            try {
              screen.orientation.unlock();
              console.log('Orientación desbloqueada');
            } catch (err) {
              console.log('No se pudo desbloquear la orientación:', err);
            }
          }

          if (document.exitFullscreen) {
            await document.exitFullscreen();
          } else if (document.webkitExitFullscreen) {
            await document.webkitExitFullscreen();
          } else if (document.mozCancelFullScreen) {
            await document.mozCancelFullScreen();
          } else if (document.msExitFullscreen) {
            await document.msExitFullscreen();
          }

          // Reactivar navegación después de salir
          setTimeout(() => {
            isManualNavigation = false;
            console.log('Exit fullscreen complete, navigation enabled');
          }, 300);
        } catch (err) {
          console.error('Error al salir de pantalla completa:', err);
          isManualNavigation = false;
        }
      };

      // Variable para guardar el índice al entrar en fullscreen (protegida)
      let fullscreenSavedIndex = 0;

      // Event listener para botón de pantalla completa
      fullscreenButton?.addEventListener('click', () => {
        // IMPORTANTE: Guardar el índice ANTES de cualquier otra cosa
        fullscreenSavedIndex = currentIndex;
        console.log(`Fullscreen button clicked, saving index: ${fullscreenSavedIndex}`);

        // Cancelar cualquier scroll timer pendiente
        if (scrollTimer) {
          clearTimeout(scrollTimer);
          scrollTimer = null;
          console.log('Cleared pending scroll timer');
        }

        // Bloquear navegación INMEDIATAMENTE
        isManualNavigation = true;

        // Ahora sí, entrar en fullscreen
        enterFullscreen();
      });

      // Event listener para botón de salir de pantalla completa
      exitFullscreenButton?.addEventListener('click', exitFullscreen);

      // Función para actualizar posición del carousel
      const updateCarouselPosition = () => {
        if (window.innerWidth <= 768) {
          const slideWidth = carousel.offsetWidth;
          if (slideWidth > 0) {
            carousel.scrollTo({
              left: slideWidth * currentIndex,
              behavior: 'auto'
            });
          }
        } else {
          updateCarousel(currentIndex, false);
        }
      };

      // Función para recalcular completamente el carousel en fullscreen (móvil)
      const recalculateFullscreenCarousel = (maintainIndex = true) => {
        if (window.innerWidth > 768) return; // Solo para móvil

        const savedIndex = maintainIndex ? currentIndex : 0;
        const viewportWidth = window.innerWidth;

        console.log(`Recalculating fullscreen carousel: index=${savedIndex}, viewport=${viewportWidth}`);

        // Forzar recálculo del layout
        const originalDisplay = carousel.style.display;
        carousel.style.display = 'none';
        carousel.offsetHeight; // Force reflow
        carousel.style.display = originalDisplay || '';

        // Resetear estilos inline que podrían interferir
        track.style.width = '';
        slides.forEach((slide) => {
          slide.style.flexBasis = '';
          slide.style.minWidth = '';
          slide.style.width = '';
        });

        // Permitir que los estilos CSS se apliquen
        requestAnimationFrame(() => {
          // Establecer el ancho del track para asegurar que contiene todas las slides
          track.style.width = `${totalSlides * 100}%`;

          // Asegurar que cada slide ocupe exactamente el viewport
          slides.forEach((slide) => {
            slide.style.flex = `0 0 ${viewportWidth}px`;
            slide.style.minWidth = `${viewportWidth}px`;
            slide.style.width = `${viewportWidth}px`;
          });

          // Establecer la posición correcta
          requestAnimationFrame(() => {
            const targetScroll = viewportWidth * savedIndex;
            console.log(`Setting scroll to ${targetScroll}`);

            // Establecer directamente sin animación
            carousel.scrollLeft = targetScroll;

            // Actualizar UI
            currentIndex = savedIndex;
            updateUIElements(savedIndex);

            // Verificación adicional
            setTimeout(() => {
              const actualScroll = carousel.scrollLeft;
              if (Math.abs(actualScroll - targetScroll) > 10) {
                console.log(`Recorrecting scroll: actual=${actualScroll}, expected=${targetScroll}`);
                carousel.scrollLeft = targetScroll;
              }
            }, 50);
          });
        });
      };

      // Listener para cambios de pantalla completa
      const handleFullscreenChange = () => {
        const isFullscreen = document.fullscreenElement ||
                           document.webkitFullscreenElement ||
                           document.mozFullScreenElement ||
                           document.msFullscreenElement;

        if (!isFullscreen) {
          gallery.classList.remove('fullscreen-active');

          // Desbloquear orientación al salir de fullscreen
          const orientation = gallery.dataset.orientation;
          if (orientation === 'landscape' && screen.orientation && screen.orientation.unlock) {
            try {
              screen.orientation.unlock();
              console.log('Orientación desbloqueada al salir de fullscreen');
            } catch (err) {
              console.log('No se pudo desbloquear orientación:', err);
            }
          }

          // Re-configurar después de salir de fullscreen
          setTimeout(() => {
            setupMediaButtons();
            updateCarouselPosition();
          }, 200);
        }
        // Nota: La entrada a fullscreen ya se maneja en enterFullscreen()
      };

      // Listener para cambios de orientación
      const handleOrientationChange = () => {
        const isFullscreen = document.fullscreenElement ||
                           document.webkitFullscreenElement ||
                           document.mozFullScreenElement ||
                           document.msFullscreenElement;

        if (isFullscreen) {
          console.log('Orientation change in fullscreen detected'); // Debug
          console.log(`Current index before change: ${currentIndex}`); // Debug

          // Deshabilitar temporalmente la navegación durante el recálculo
          isManualNavigation = true;

          const orientation = gallery.dataset.orientation;

          // Para galerías landscape, intentar mantener orientación horizontal
          if (orientation === 'landscape' && screen.orientation && screen.orientation.lock) {
            // Verificar orientación actual
            const currentOrientation = screen.orientation.type;
            if (currentOrientation.includes('portrait')) {
              // Si cambió a vertical, intentar volver a horizontal
              screen.orientation.lock('landscape').catch(err => {
                console.log('No se pudo mantener orientación landscape:', err);
              });
            }
          }

          // Dar tiempo al navegador para actualizar las dimensiones del viewport
          setTimeout(() => {
            console.log(`New dimensions - Width: ${window.innerWidth}, Height: ${window.innerHeight}`); // Debug

            // Forzar recálculo de estilos para evitar fondo negro
            gallery.style.display = 'none';
            gallery.offsetHeight; // Force reflow
            gallery.style.display = '';

            // Recalcular completamente el carousel manteniendo el índice actual
            recalculateFullscreenCarousel(true);

            // Re-configurar event listeners de scroll si es móvil
            if (window.innerWidth <= 768) {
              // Remover listener anterior si existe
              carousel.removeEventListener('scroll', handleMobileScroll);
              // Agregar nuevo listener después de un pequeño delay
              setTimeout(() => {
                carousel.addEventListener('scroll', handleMobileScroll, { passive: true });
              }, 100);
            }

            // Verificación adicional del scroll después de un momento
            setTimeout(() => {
              const viewportWidth = window.innerWidth;
              const expectedScroll = viewportWidth * currentIndex;
              const actualScroll = carousel.scrollLeft;
              console.log(`Scroll verification - Actual: ${actualScroll}, Expected: ${expectedScroll}`); // Debug

              if (Math.abs(actualScroll - expectedScroll) > 10) {
                console.log('Correcting scroll position...'); // Debug
                carousel.scrollLeft = expectedScroll;
              }

              // Reactivar navegación
              isManualNavigation = false;
              console.log('Orientation change complete, navigation enabled');
            }, 500);
          }, 400); // Dar tiempo suficiente para el cambio de orientación
        }
      };

      document.addEventListener('fullscreenchange', handleFullscreenChange);
      document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
      document.addEventListener('mozfullscreenchange', handleFullscreenChange);
      document.addEventListener('MSFullscreenChange', handleFullscreenChange);

      // Agregar listeners de orientación
      if (screen.orientation) {
        screen.orientation.addEventListener('change', handleOrientationChange);
      } else {
        // Fallback para navegadores antiguos
        window.addEventListener('orientationchange', handleOrientationChange);
      }

      // Actualizar en resize
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          const isFullscreen = document.fullscreenElement ||
                             document.webkitFullscreenElement ||
                             document.mozFullScreenElement ||
                             document.msFullscreenElement;

          // Si estamos en fullscreen y es móvil, recalcular completamente
          if (isFullscreen && window.innerWidth <= 768) {
            console.log('Resize in fullscreen mobile detected'); // Debug
            recalculateFullscreenCarousel(true);
          } else if (isFullscreen) {
            // Desktop en fullscreen
            updateCarouselPosition();
          } else {
            // Modo normal
            updateCarousel(currentIndex);
          }
        }, 250);
      });

      // Manejar navegación por índice
      const navLinks = wrapper.querySelectorAll('.navigation-index-link');
      navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetIndex = parseInt(link.dataset.slideIndex, 10);

          if (!isNaN(targetIndex) && targetIndex >= 0 && targetIndex < totalSlides) {
            // Activar flag de navegación manual
            isManualNavigation = true;
            console.log(`Navigation index link clicked, jumping to slide ${targetIndex}`);

            // Si estamos en fullscreen, guardar el índice
            const isFullscreen = gallery.classList.contains('fullscreen-active');
            if (isFullscreen) {
              fullscreenSavedIndex = targetIndex;
            }

            // Navegar a la slide
            updateCarousel(targetIndex, true);

            // Cerrar el índice después de navegar (solo si es móvil)
            if (window.innerWidth <= 768) {
              const details = wrapper.querySelector('.navigation-index-details');
              if (details) {
                details.removeAttribute('open');
              }
            }

            // Desactivar navegación manual después de un tiempo
            setTimeout(() => {
              isManualNavigation = false;
              console.log('Manual navigation disabled after index click');
            }, 800);
          }
        });
      });

      // Inicializar la primera slide como activa
      updateCarousel(0);
    });
  });
</script>