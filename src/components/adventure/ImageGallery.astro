---
import { Image, getImage } from 'astro:assets';
import MediaModal from './MediaModal';
import { getTranslations } from '../../i18n/utils';

interface Props {
  images: Array<{
    src: string;
    alt: string;
    mediaButton?: {
      type: 'audio' | 'video';
      url: string;
      label: string;
    };
    buttonText?: string;
    stopName?: string;
  }>;
  orientation: 'landscape' | 'portrait';
  buttonsPosition?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  language?: 'es' | 'en';
}

const { images, orientation, buttonsPosition = 'top-right', language = 'es' } = Astro.props;

const isLandscape = orientation === 'landscape';

// Obtener traducciones de los archivos i18n
const translations = await getTranslations(language);

// Funciones auxiliares para interpolación de traducciones
const interpolate = (template: string, values: Record<string, any>) => {
  return template.replace(/\{\{(\w+)\}\}/g, (_, key) => values[key] ?? '');
};

// Textos de accesibilidad usando las traducciones oficiales
const t = {
  galleryLabel: translations.aria.gallery.galleryLabel,
  imageLabel: (current: number, total: number) =>
    interpolate(translations.aria.gallery.imageLabel, { current, total }),
  previousImage: translations.aria.gallery.previousImage,
  nextImage: translations.aria.gallery.nextImage,
  goToImage: (index: number, alt: string) =>
    interpolate(translations.aria.gallery.goToImage, { index, description: alt }),
  playAudio: (alt: string) =>
    interpolate(translations.aria.gallery.playAudio, { description: alt }),
  playVideo: (alt: string) =>
    interpolate(translations.aria.gallery.playVideo, { description: alt }),
  fullscreen: translations.aria.gallery.fullscreen,
  exitFullscreen: translations.aria.gallery.exitFullscreen,
  indicatorsLabel: translations.aria.gallery.indicatorsLabel,
  currentImage: (current: number, total: number, alt: string) =>
    interpolate(translations.aria.gallery.currentImage, { current, total, description: alt }),
  navigationIndex: translations.aria.gallery.navigationIndex,
  toggleIndex: translations.aria.gallery.toggleIndex,
  stopsOverview: translations.aria.gallery.stopsOverview,
  stopNumber: translations.aria.gallery.stopNumber,
  skipToStop: translations.aria.gallery.skipToStop,
  currentStop: translations.aria.gallery.currentStop
};

// Determinar las clases de posición para los botones
const positionClasses = {
  'top-left': 'top-4 left-4',
  'top-right': 'top-4 right-4',
  'bottom-left': 'bottom-4 left-4',
  'bottom-right': 'bottom-4 right-4'
}[buttonsPosition];

// Importar todas las imágenes de la carpeta de aventuras
const imageImports = import.meta.glob('/src/assets/images/adventures/**/*.{jpg,jpeg,png,webp,avif}');

// Función para cargar las imágenes dinámicamente
async function loadImage(imagePath: string) {
  let normalizedPath = imagePath;
  if (!normalizedPath.startsWith('/src/')) {
    normalizedPath = `/src/assets/images/adventures/${imagePath}`;
  }

  const imageLoader = imageImports[normalizedPath];
  if (imageLoader) {
    const module = await imageLoader();
    return module.default;
  }
  console.warn(`Image not found: ${normalizedPath}`);
  return null;
}

// Cargar y optimizar todas las imágenes
const optimizedImages = await Promise.all(
  images.map(async (img) => {
    const imageModule = await loadImage(img.src);
    if (!imageModule) return null;

    // Configurar dimensiones según orientación
    const dimensions = isLandscape
      ? { width: 1920, height: 1080 }  // 16:9
      : { width: 1080, height: 1920 }; // 9:16

    // Generar múltiples tamaños para responsive
    const sizes = isLandscape
      ? [640, 768, 1024, 1366, 1920]
      : [480, 640, 768, 1024, 1080];

    // Optimizar imagen principal
    const optimizedImage = await getImage({
      src: imageModule,
      width: dimensions.width,
      height: dimensions.height,
      format: 'webp',
      quality: 85
    });

    // Generar srcset para diferentes tamaños
    const srcsetWebp = await Promise.all(
      sizes.map(async (size) => {
        const opt = await getImage({
          src: imageModule,
          width: size,
          format: 'webp',
          quality: 85
        });
        return `${opt.src} ${size}w`;
      })
    );

    // Fallback en JPEG
    const fallback = await getImage({
      src: imageModule,
      width: dimensions.width,
      height: dimensions.height,
      format: 'jpg',
      quality: 85
    });

    return {
      ...img,
      optimized: optimizedImage,
      srcsetWebp: srcsetWebp.join(', '),
      fallback: fallback.src,
      sizes: isLandscape
        ? '(max-width: 640px) 640px, (max-width: 768px) 768px, (max-width: 1024px) 1024px, (max-width: 1366px) 1366px, 1920px'
        : '(max-width: 480px) 480px, (max-width: 640px) 640px, (max-width: 768px) 768px, (max-width: 1024px) 1024px, 1080px'
    };
  })
);

// Filtrar imágenes que no se pudieron cargar
const validImages = optimizedImages.filter(img => img !== null);

// Preparar datos para el índice de navegación
const stopsData = validImages.map((image, index) => ({
  index,
  stopName: image.stopName || image.buttonText || interpolate(t.stopNumber, { number: index + 1 }),
  alt: image.alt
}));
---

<!-- Índice de Navegación Accesible -->
<nav class="gallery-navigation-index" aria-label={t.navigationIndex}>
  <details class="navigation-index-details">
    <summary class="navigation-index-toggle" aria-label={t.toggleIndex}>
      <svg aria-hidden="true" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <span>{t.navigationIndex}</span>
      <svg aria-hidden="true" class="w-5 h-5 ml-2 chevron-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </summary>
    <div class="navigation-index-content">
      <p class="navigation-index-overview" aria-live="polite">
        {interpolate(t.stopsOverview, { count: validImages.length })}
      </p>
      <ul class="navigation-index-list" role="list">
        {stopsData.map((stop) => (
          <li key={stop.index}>
            <a
              href={`#slide-${stop.index}`}
              class="navigation-index-link"
              data-slide-index={stop.index}
              aria-label={interpolate(t.skipToStop, { stopName: stop.stopName })}
            >
              <span class="stop-number" aria-hidden="true">{stop.index + 1}</span>
              <span class="stop-name">{stop.stopName}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>
</nav>

<div class="adventure-gallery-wrapper">
  <div
    class="adventure-gallery-container relative bg-black"
    data-orientation={orientation}
    data-buttons-position={buttonsPosition}
  >
    <!-- Botón de salir de pantalla completa (oculto por defecto) -->
    <button
      class="exit-fullscreen-button hidden fixed top-4 right-4 z-[10001] bg-black/70 hover:bg-black/90 text-white p-3 rounded-full transition-all duration-300"
      aria-label={t.exitFullscreen}
    >
      <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Mensaje de rotación para landscape en móvil vertical -->
    {orientation === 'landscape' && (
      <div class="rotate-device-message hidden fixed inset-0 z-[10002] bg-black/95 flex items-center justify-center">
        <div class="text-center text-white p-8">
          <svg class="w-24 h-24 mx-auto mb-4 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <p class="text-xl font-semibold mb-2">
            {language === 'en' ? 'Please rotate your device' : 'Por favor, gira tu dispositivo'}
          </p>
          <p class="text-sm opacity-80">
            {language === 'en'
              ? 'This content is best viewed in landscape mode'
              : 'Este contenido se ve mejor en modo horizontal'}
          </p>
        </div>
      </div>
    )}

    <!-- Contenedor del Carousel con controles fuera del área scrolleable -->
    <div class="gallery-wrapper relative">
      <!-- Contenedor del Carousel -->
      <div
        class="gallery-carousel relative overflow-hidden"
        role="region"
        aria-roledescription="carousel"
        aria-label={t.galleryLabel}
      >
        <!-- Track de imágenes -->
        <div class="gallery-track flex transition-transform duration-300 ease-in-out">
          {validImages.map((image, index) => (
            <div
              id={`slide-${index}`}
              class="gallery-slide flex-shrink-0 w-full relative"
              data-slide-index={index}
              role="group"
              aria-roledescription="slide"
              aria-label={t.imageLabel(index + 1, validImages.length)}
            >
              <!-- Contenedor de imagen con aspect ratio -->
              <div class={`relative ${isLandscape ? 'aspect-video' : 'aspect-[9/16] md:aspect-auto md:h-[70vh] md:w-full md:flex md:items-center md:justify-center'} bg-white dark:bg-slate-900`}>
                <picture class={isLandscape ? '' : 'md:flex md:items-center md:justify-center md:h-full'}>
                  <source
                    type="image/webp"
                    srcset={image.srcsetWebp}
                    sizes={image.sizes}
                  />
                  <source
                    type="image/jpeg"
                    srcset={image.fallback}
                  />
                  <img
                    src={image.optimized.src}
                    alt={image.alt}
                    width={image.optimized.attributes.width}
                    height={image.optimized.attributes.height}
                    class={isLandscape ? 'w-full h-full object-cover' : 'w-full h-full object-cover md:w-auto md:h-auto md:max-h-[70vh] md:object-contain md:mx-auto'}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding={index === 0 ? 'sync' : 'async'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                </picture>

                <!-- Botón de Media (si aplica) -->
                {image.mediaButton && (
                  <div class={`media-button-container absolute ${positionClasses} z-20`}>
                    <button
                      class="media-button bg-black/70 hover:bg-black/90 text-white transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-SM-blue focus:ring-offset-2 flex items-center gap-3"
                      data-media-type={image.mediaButton.type}
                      data-media-url={image.mediaButton.url}
                      data-slide-index={index}
                      aria-label={image.mediaButton.type === 'audio' ? t.playAudio(image.alt) : t.playVideo(image.alt)}
                      style={image.buttonText ? 'border-radius: 9999px; padding: 0.75rem 1.25rem 0.75rem 1rem;' : 'border-radius: 9999px; padding: 1rem;'}
                    >
                      {image.buttonText && (
                        <span class="button-text text-base sm:text-lg font-semibold whitespace-pre-line text-center" set:html={image.buttonText}>
                        </span>
                      )}
                      <div class="flex-shrink-0">
                        {image.mediaButton.type === 'audio' ? (
                          <svg aria-hidden="true" class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="#FBBF24" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
                          </svg>
                        ) : (
                          <svg aria-hidden="true" class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="#FBBF24" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                          </svg>
                        )}
                      </div>
                    </button>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Controles de navegación fuera del carousel para que se mantengan fijos -->
      <button
        class="gallery-prev absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 bg-black/70 dark:bg-black/50 hover:bg-black/90 dark:hover:bg-black/70 text-white p-2 sm:p-3 rounded-full transition-all z-30 flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed shadow-lg ring-2 ring-white/20"
        aria-label={t.previousImage}
        disabled
      >
        <svg aria-hidden="true" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <button
        class="gallery-next absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 bg-black/70 dark:bg-black/50 hover:bg-black/90 dark:hover:bg-black/70 text-white p-2 sm:p-3 rounded-full transition-all z-30 flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed shadow-lg ring-2 ring-white/20"
        aria-label={t.nextImage}
        disabled={validImages.length <= 1}
      >
        <svg aria-hidden="true" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    <!-- Indicadores de puntos -->
    {validImages.length > 1 && (
      <div
        class="gallery-indicators absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-10"
        role="tablist"
        aria-label={t.indicatorsLabel}
      >
        {validImages.map((image, index) => (
          <button
            class={`indicator w-2 h-2 rounded-full transition-all duration-300 ${
              index === 0 ? 'bg-white w-8' : 'bg-white/50 hover:bg-white/70'
            }`}
            data-slide-target={index}
            role="tab"
            aria-selected={index === 0}
            aria-label={t.goToImage(index + 1, image.alt)}
          />
        ))}
      </div>
    )}
  </div>

  <!-- Botón de pantalla completa (fuera de la galería) -->
  <div class="fullscreen-button-container mt-4 flex justify-center">
    <button
      class="fullscreen-button bg-SM-blue hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-SM-blue focus:ring-offset-2 flex items-center gap-2 shadow-lg"
      aria-label={t.fullscreen}
    >
      <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
      </svg>
      <span>{t.fullscreen}</span>
    </button>
  </div>

  <!-- Live Region para anunciar cambios de slide -->
  <div role="status" aria-live="polite" aria-atomic="true" class="sr-only gallery-live-region"></div>
</div>

<!-- Modal para Media -->
<MediaModal language={language} client:load />

<style>
  /* ===== ESTILOS DEL ÍNDICE DE NAVEGACIÓN ===== */
  .gallery-navigation-index {
    margin-bottom: 1.5rem;
    max-width: 100%;
  }

  .navigation-index-details {
    border: 2px solid #e5e7eb;
    border-radius: 0.75rem;
    overflow: hidden;
    background: white;
    transition: all 0.3s ease;
  }

  .navigation-index-details:hover {
    border-color: #0072c0;
    box-shadow: 0 4px 6px -1px rgba(0, 114, 192, 0.1);
  }

  .navigation-index-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, #0072c0 0%, #005a99 100%);
    color: white;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.125rem;
    user-select: none;
    transition: background 0.3s ease;
    list-style: none;
  }

  .navigation-index-toggle::-webkit-details-marker {
    display: none;
  }

  .navigation-index-toggle:hover {
    background: linear-gradient(135deg, #005a99 0%, #004577 100%);
  }

  .navigation-index-toggle:focus-visible {
    outline: 3px solid #FBBF24;
    outline-offset: 2px;
  }

  .navigation-index-toggle span {
    display: flex;
    align-items: center;
  }

  .chevron-icon {
    transition: transform 0.3s ease;
  }

  .navigation-index-details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .navigation-index-content {
    padding: 1.25rem;
    background: #f9fafb;
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .navigation-index-overview {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: white;
    border-left: 4px solid #0072c0;
    font-size: 0.95rem;
    color: #374151;
    border-radius: 0.25rem;
  }

  .navigation-index-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .navigation-index-list {
      grid-template-columns: 1fr;
    }
  }

  .navigation-index-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    text-decoration: none;
    color: #374151;
    transition: all 0.2s ease;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .navigation-index-link:hover {
    background: #eff6ff;
    border-color: #0072c0;
    color: #0072c0;
    transform: translateX(4px);
  }

  .navigation-index-link:focus-visible {
    outline: 3px solid #FBBF24;
    outline-offset: 2px;
    border-color: #0072c0;
  }

  .navigation-index-link:active {
    transform: scale(0.98);
  }

  .stop-number {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    background: linear-gradient(135deg, #0072c0 0%, #005a99 100%);
    color: white;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .navigation-index-link:hover .stop-number {
    background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%);
    color: #1F2937;
  }

  .stop-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .navigation-index-details {
      background: #1f2937;
      border-color: #374151;
    }

    .navigation-index-content {
      background: #111827;
    }

    .navigation-index-overview {
      background: #1f2937;
      color: #d1d5db;
    }

    .navigation-index-link {
      background: #1f2937;
      border-color: #374151;
      color: #d1d5db;
    }

    .navigation-index-link:hover {
      background: #374151;
      border-color: #0072c0;
      color: #60a5fa;
    }
  }

  /* ===== ESTILOS ORIGINALES ===== */
  /* Contenedor wrapper necesita position relative para las flechas */
  .gallery-wrapper {
    position: relative;
  }

  /* Estilos base para móvil con snap scroll mejorado */
  @media (max-width: 768px) {
    .gallery-carousel {
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      overflow-x: scroll;
      overflow-y: hidden;
      scrollbar-width: none;
      /* Importante: NO usar scroll-behavior smooth aquí para evitar conflictos */
      /* scroll-behavior será controlado por JavaScript */
      /* Prevenir el problema de quedarse entre slides */
      scroll-padding: 0;
      overscroll-behavior-x: contain; /* Prevenir el bounce en iOS */
    }

    .gallery-carousel::-webkit-scrollbar {
      display: none;
    }

    .gallery-track {
      display: flex;
      transition: none;
      /* Asegurar que no haya espacios entre slides */
      gap: 0;
      will-change: transform; /* Optimización de rendimiento */
    }

    .gallery-slide {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      flex: 0 0 100%;
      min-width: 100%;
      width: 100%;
      backface-visibility: hidden; /* Prevenir parpadeos */
    }
  }

  /* Estilos para botones de navegación en móvil */
  .gallery-prev,
  .gallery-next {
    /* Asegurar que siempre estén encima del contenido */
    z-index: 30 !important;
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .gallery-prev,
    .gallery-next {
      /* Hacer los botones más visibles en móvil */
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    /* Ajustar posición para evitar conflicto con botones de media */
    .gallery-prev {
      left: 0.5rem;
    }

    .gallery-next {
      right: 0.5rem;
    }
  }

  /* Estilos para botón de media */
  .media-button {
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Por defecto, ocultar todos los botones */
  .media-button-container {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.3s ease-in-out;
  }

  /* En modo normal, mostrar solo botones de slide activa */
  .gallery-slide.active-slide .media-button-container {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  /* En fullscreen, mostrar TODOS los botones en su imagen correspondiente */
  .fullscreen-active .media-button-container {
    opacity: 1 !important;
    pointer-events: auto !important;
    visibility: visible !important;
  }

  /* Estilos para modo fullscreen */
  .fullscreen-active {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 9999 !important;
    background: black !important;
  }

  .fullscreen-active .gallery-carousel {
    height: 100vh !important;
  }

  .fullscreen-active .gallery-slide {
    height: 100vh !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fullscreen-active .gallery-slide > div {
    position: relative;
    width: 100%;
    max-width: 100vw;
    max-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

