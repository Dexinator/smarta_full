---
import { Image, getImage } from 'astro:assets';

// Importar imágenes de aventuras y main_page
const adventureImages = import.meta.glob('/src/assets/images/{adventures,main_page}/**/*.{jpg,jpeg,png,webp,avif}');

interface Adventure {
  title: string;
  link: string;
  image: string;
}

interface Props {
  adventures?: Adventure[];
  currentAdventure?: string;
  lang?: string;
}

const { adventures: propsAdventures, currentAdventure, lang = 'es' } = Astro.props;

// Textos según idioma
const texts = {
  es: {
    title: 'Vive más experiencias en Santa Marta',
    subtitle: 'Descubre más aventuras disponibles'
  },
  en: {
    title: 'Live more experiences in Santa Marta',
    subtitle: 'Discover more available adventures'
  }
};

const currentTexts = texts[lang] || texts.es;

// Definir todas las aventuras disponibles con sus burbujas
const allAdventures = {
  detectives: {
    es: {
      title: 'Detectives en acción',
      link: '/aventuras/detectives/espanol',
      image: 'burbujas/burbuja_detectives.png'
    },
    en: {
      title: 'Kingfisher Detectives',
      link: '/aventuras/detectives/ingles',
      image: 'burbujas/burbuja_detectives_ingles.png'
    }
  },
  'urban-escape': {
    es: {
      title: 'Santa Marta Urban Escape',
      link: '/aventuras/urban-escape/',
      image: 'burbujas/burbuja_urban_escape.png'
    },
    en: {
      title: 'Santa Marta Urban Escape',
      link: '/aventuras/urban-escape/ingles',
      image: 'burbujas/burbuja_urban_escape.png' // Misma imagen para ambos idiomas
    }
  },
  'santa-martaxplora': {
    es: {
      title: 'Santa MartaXplora',
      link: '/aventuras/santa-martaxplora/',
      image: 'burbujas/burbuja_xplora.png'
    },
    en: {
      title: 'Santa MartaXplora',
      link: '/aventuras/santa-martaxplora/ingles',
      image: 'burbujas/burbuja_xplora_ingles.png'
    }
  }
};

// Generar aventuras dinámicamente si no se proporcionan
let adventures;
if (propsAdventures && propsAdventures.length > 0) {
  adventures = propsAdventures;
} else if (currentAdventure) {
  // Si tenemos currentAdventure, mostrar las otras 2
  const adventureKeys = Object.keys(allAdventures);
  const otherAdventures = adventureKeys.filter(key => key !== currentAdventure);

  adventures = otherAdventures.map(key => {
    const adventure = allAdventures[key];
    const adventureData = adventure[lang] || adventure.es;
    return adventureData;
  });
} else {
  // Si no hay currentAdventure ni adventures, mostrar todas
  adventures = Object.values(allAdventures).map(adventure => {
    const adventureData = adventure[lang] || adventure.es;
    return adventureData;
  });
}

// Función para cargar las imágenes dinámicamente
async function loadImage(imagePath: string) {
  let normalizedPath = imagePath;
  if (!normalizedPath.startsWith('/src/')) {
    normalizedPath = `/src/assets/images/adventures/${imagePath}`;
  }

  const imageLoader = adventureImages[normalizedPath];
  if (imageLoader) {
    const module = await imageLoader();
    return module.default;
  }

  // Fallback a imagen de main_page si no se encuentra la imagen
  try {
    const fallbackPath = `/src/assets/images/main_page/santa marta explora.png`;
    const fallbackLoader = adventureImages[fallbackPath];
    if (fallbackLoader) {
      const module = await fallbackLoader();
      return module.default;
    }
  } catch (e) {
    console.warn(`Image not found: ${normalizedPath}`);
  }

  return null;
}

// Cargar todas las imágenes
const adventuresWithImages = await Promise.all(
  adventures.map(async (adventure) => ({
    ...adventure,
    img: await loadImage(adventure.image)
  }))
);

// Filtrar aventuras con imágenes válidas
const validAdventures = adventuresWithImages.filter(a => a.img !== null);
---

{validAdventures && validAdventures.length > 0 && (
  <section id="otras-aventuras" class="bg-slate-50 dark:bg-slate-800 py-12 sm:py-16 md:py-20">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Título -->
      <div class="text-center mb-8 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-2 sm:mb-3">
          {currentTexts.title}
        </h2>
        <p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 mt-3">
          {currentTexts.subtitle}
        </p>
      </div>

      <!-- Grid de burbujas con imágenes optimizadas -->
      <div class={validAdventures.length <= 2
        ? "flex flex-wrap justify-center gap-8 sm:gap-12"
        : "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-6"}>
        {validAdventures.map((adventure, index) => {
          // Las primeras 6 imágenes se cargan con prioridad alta
          const isEager = index < 6;
          return (
            <a
              href={adventure.link}
              class="flex flex-col items-center group"
              aria-label={`Ir a ${adventure.title}`}
            >
              <div class={validAdventures.length <= 2
                ? "w-32 h-32 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-full shadow-lg group-hover:shadow-xl group-active:scale-95 transform transition-all overflow-hidden mb-3 bg-gradient-to-br from-SM-blue to-blue-700"
                : "w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 rounded-full shadow-lg group-hover:shadow-xl group-active:scale-95 transform transition-all overflow-hidden mb-3 bg-gradient-to-br from-SM-blue to-blue-700"}>
                {adventure.img && (
                  <Image
                    src={adventure.img}
                    alt={adventure.title}
                    width={256}
                    height={256}
                    widths={[96, 128, 192, 256]}
                    sizes="(max-width: 640px) 96px, (max-width: 768px) 112px, 128px"
                    format="webp"
                    quality={80}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                    loading={isEager ? "eager" : "lazy"}
                    decoding={isEager ? "sync" : "async"}
                  />
                )}
              </div>
              <h3 class="text-sm sm:text-base md:text-lg font-semibold text-slate-900 dark:text-white text-center px-2 group-hover:text-SM-blue dark:group-hover:text-SM-yellow transition-colors">
                {adventure.title}
              </h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  /* Animación suave al hacer hover */
  @media (hover: hover) {
    .group:hover .group-hover\:scale-110 {
      transform: scale(1.1);
    }
  }

  /* Asegurar que las burbujas mantengan proporción circular */
  .rounded-full {
    aspect-ratio: 1;
  }
</style>