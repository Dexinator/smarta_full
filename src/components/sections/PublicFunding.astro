---
// Public Funding Section - Financiación pública
import { Image } from 'astro:assets';
import juntaImg from '../../assets/images/financiacion/Logotipo_de_la_Junta_de_Castilla_y_León.svg.png';
import mtesImg from '../../assets/images/financiacion/MTES+SEPE-H-COLOR-CAS.png';

export interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const content = {
  es: {
    title: "Financiación pública",
    text: "Proyecto subvencionado por la Junta de Castilla y León al amparo de la Orden IEM/757/2025.\nDesarrollo de una página web totalmente accesible, adaptada a criterios de accesibilidad universal, con el objetivo de garantizar el acceso a la información y servicios digitales a todas las personas.\nSe ha conseguido una mejora significativa en la usabilidad y accesibilidad del sitio web, favoreciendo la inclusión digital.",
    juntaAlt: "Logotipo de la Junta de Castilla y León",
    mtesAlt: "Logotipo del Ministerio de Trabajo y Economía Social - SEPE"
  },
  en: {
    title: "Public Funding",
    text: "Project funded by the Junta de Castilla y León under Order IEM/757/2025.\nDevelopment of a fully accessible website, adapted to universal accessibility criteria, with the aim of ensuring access to information and digital services for all people.\nA significant improvement in the usability and accessibility of the website has been achieved, promoting digital inclusion.",
    juntaAlt: "Logo of the Junta de Castilla y León",
    mtesAlt: "Logo of the Ministry of Labour and Social Economy - SEPE"
  }
};

const t = content[lang as keyof typeof content] || content.es;
const paragraphs = t.text.split('\n');
---

<section
  id="public-funding"
  class="py-16 bg-white dark:bg-slate-800"
>
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-slate-100">
        {t.title}
      </h2>
    </div>

    <div class="max-w-4xl mx-auto">
      <!-- Logos -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-8 mb-10">
        <div class="bg-white border border-slate-200 dark:border-slate-600 rounded-xl p-4">
          <Image
            src={juntaImg}
            alt={t.juntaAlt}
            class="h-20 md:h-24 w-auto object-contain"
            widths={[200, 400]}
            sizes="200px"
            quality={90}
            loading="lazy"
          />
        </div>
        <div class="bg-white border border-slate-200 dark:border-slate-600 rounded-xl p-4">
          <Image
            src={mtesImg}
            alt={t.mtesAlt}
            class="h-20 md:h-24 w-auto object-contain"
            widths={[400, 800]}
            sizes="400px"
            quality={95}
            loading="lazy"
          />
        </div>
      </div>

      <!-- Texto -->
      <div class="text-center space-y-4">
        {paragraphs.map((paragraph) => (
          <p class="text-base md:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
